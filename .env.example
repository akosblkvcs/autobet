# development or production; production switches logs to JSON.
ENVIRONMENT=development
# Root log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Which tip sources to run; keys of autobet/sources/.
SOURCES=telegram
# Where bets are placed; keys of autobet/bookmakers/.
# Ignored while DRY_RUN is on, which always forces the paper book.
BOOKMAKER=paper

# Telegram API credentials from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session file, full path including the .session extension.
TELEGRAM_SESSION=data/telethon.session
# Where media files are saved.
MEDIA_DIR=data/media
# Comma-separated chat ids from `make chats`.
TELEGRAM_SOURCE_CHAT_IDS=

# Legacy (not an identity-linked) key.
ANTHROPIC_API_KEY=

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobet

# Bind address; must be 0.0.0.0 in prod or the proxy cannot reach it.
HTTP_HOST=127.0.0.1
# Port the control plane listens on, matching EXPOSE in the Dockerfile.
HTTP_PORT=8000
# Shared secret for guarded pages like /; unset locks them.
AUTOBET_TOKEN=

# Master safety switch: when True, nothing is ever staked for real.
DRY_RUN=True
# Flat amount staked on every tips.
STAKE=100
# Abandon a bet when the live odds have dropped this many percent.
MAX_ODDS_DROP_PERCENT=10
