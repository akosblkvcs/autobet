# Available environments: development, production.
ENVIRONMENT=development
# Available log levels: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Directory where persistent data is stored.
DATA_DIR=data

# The book's login.
BOOK_USERNAME=
BOOK_PASSWORD=

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobet

# Bind address.
HTTP_HOST=127.0.0.1
# Port the control plane listens on.
HTTP_PORT=8000

# OpenID Connect configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
ADMIN_EMAILS=

# Master safety switch: when True, nothing is ever staked for real.
DRY_RUN=True
