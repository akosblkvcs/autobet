# Available environments: development, production.
ENVIRONMENT=development
# Available log levels: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Directory where persistent data is stored.
DATA_DIR=data

# Telegram API credentials from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Comma-separated chat ids from `make chats`.
TELEGRAM_SOURCE_CHAT_IDS=
# Chats whose tips skip all checks.
TELEGRAM_FORCE_CHAT_IDS=

# Claude API key. Must be a plain key, not an identity-linked one.
CLAUDE_API_KEY=

# The book data.
BOOK_SITE=
BOOK_API=
BOOK_LOADER=
BOOK_WS=
BOOK_REALM=
BOOK_OPERATOR=
BOOK_USERNAME=
BOOK_PASSWORD=

# Quiet hours.
QUIET_FROM_HOUR=23
QUIET_UNTIL_HOUR=7
QUIET_TIMEZONE=Europe/Budapest

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobet

# Bind address.
HTTP_HOST=127.0.0.1
# Port the control plane listens on.
HTTP_PORT=8000
# Shared secret for guarded pages.
AUTOBET_TOKEN=

# Master safety switch: when True, nothing is ever staked for real.
DRY_RUN=True
# Flat amount staked on every tip.
STAKE=100
# Abandon a bet when the live odds have dropped this many percent.
MAX_ODDS_DROP_PERCENT=10
# Maximum number of days in advance an event can be scheduled.
MAX_EVENT_DAYS_AHEAD=7
